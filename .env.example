# Wird NICHT vom Browser gelesen (statische App ohne Build-Schritt),
# sondern dient als Vorlage fuer die GitHub-Actions-Secrets bzw. fuer
# lokale Tools wie die Supabase-CLI.
#
# Fuer den Deploy: diese Werte als Repository-Secrets hinterlegen
# (Settings -> Secrets and variables -> Actions).

SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
SUPABASE_ANON_KEY=DEIN-ANON-PUBLISHABLE-KEY
HCAPTCHA_SITE_KEY=
